# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files to always be normalized with LF line endings
*.kt text diff=kotlin eol=lf
*.kts text diff=kotlin eol=lf
*.java text diff=java eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.pro text eol=lf

# Windows batch files must retain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must have LF
gradlew text eol=lf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.aar binary
*.so binary
